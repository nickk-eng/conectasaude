# Acrescente as configurações SMTP ao seu .env, preservando as existentes.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/conectasaude
PORT=3000
ADMIN_EMAIL=admin@conectasaude.com
ADMIN_SENHA=defina-uma-senha-forte
MFA_ENCRYPTION_KEY=gere-uma-chave-base64-de-32-bytes-conforme-o-README
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM="ConectaSaúde <seuemail@gmail.com>"
